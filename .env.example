DEBUG=false
LOG_LEVEL=info

# Nginx proxy port, http://localhost:8010/
NGINX_OUT_PORT=8010

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ainewsbot
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=ainewsbot

# PgAdmin
PGADMIN_EMAIL=admin@local.org
PGADMIN_PASSWORD=strong_password
PGADMIN_PORT=8095

# Rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=strong_password

# Telegram
TG_BOT_API_KEY=
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=telegram_session
TG_PUBLISH_CHANNEL=-100

# OpenAI
OPENAI_API_KEY=
#"gpt-3.5-turbo"
OPENAI_MODEL="gpt-4o"  
OPENAI_MODEL_TEMPERATURE=0.7
